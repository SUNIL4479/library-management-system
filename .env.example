# MONGODB_URI: Connection string for MongoDB (Atlas or local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_db?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/library_management
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_db?retryWrites=true&w=majority"

# PORT: Server port (default: 3000)
PORT="3000"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
